# syntax=docker/dockerfile:1.7
# Montr Secure — operator console (Next.js). Multi-stage, DISTROLESS, non-root.
#
# NOTE: apps/web is currently a Wave-0 TypeScript stub. This Dockerfile builds
# and ships that stub today so the image and compose/Helm wiring stay green.
# When WS-K converts apps/web into a Next.js 14 App-Router app, switch to the
# Next standalone runtime by:
#   1. setting `output: "standalone"` in apps/web/next.config.mjs,
#   2. replacing the build step with `pnpm --filter @montr/web build`,
#   3. copying `.next/standalone`, `.next/static`, and `public` into /app,
#   4. changing CMD to ["apps/web/server.js"] (the standalone entrypoint),
#   5. mounting a writable emptyDir at /app/apps/web/.next/cache (ISR cache).
# The runtime contract (distroless, non-root, port 3000, /tmp writable) is stable.
#
# Build context is the REPO ROOT (docker-compose.yml sets `context: ../..`).

ARG NODE_VERSION=20-bookworm-slim
ARG DISTROLESS=gcr.io/distroless/nodejs20-debian12:nonroot

# ---------------------------------------------------------------------------
# base
# ---------------------------------------------------------------------------
FROM node:${NODE_VERSION} AS base
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    CI=true \
    NEXT_TELEMETRY_DISABLED=1
RUN corepack enable
WORKDIR /repo

# ---------------------------------------------------------------------------
# build
# ---------------------------------------------------------------------------
FROM base AS build
COPY . .
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile
RUN pnpm exec tsc -b
RUN pnpm --filter @montr/web deploy --prod --legacy /app

# ---------------------------------------------------------------------------
# runtime
# ---------------------------------------------------------------------------
FROM ${DISTROLESS} AS runtime
LABEL org.opencontainers.image.title="montr-secure-web" \
      org.opencontainers.image.description="Montr Secure operator console (Next.js)" \
      org.opencontainers.image.source="https://github.com/montr/secure" \
      org.opencontainers.image.licenses="Proprietary"
WORKDIR /app
ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    NEXT_TELEMETRY_DISABLED=1
COPY --from=build --chown=nonroot:nonroot /app /app
USER nonroot
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
    CMD ["/nodejs/bin/node", "-e", "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/').then(function(r){process.exit(r.status<500?0:1)}).catch(function(){process.exit(1)})"]
CMD ["dist/index.js"]
