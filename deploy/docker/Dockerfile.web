# syntax=docker/dockerfile:1.7
# Montr Secure — operator console (Next.js 16, App Router). Multi-stage,
# DISTROLESS, non-root. Ships the real Next.js app via the standalone output
# (apps/web/next.config.mjs sets `output: "standalone"`), built with the
# webpack builder (`build:next`) because Turbopack cannot resolve this repo's
# .js-extension TS import convention.
#
# Build context is the REPO ROOT (docker-compose.yml sets `context: ../..`).

ARG NODE_VERSION=20-bookworm-slim
ARG DISTROLESS=gcr.io/distroless/nodejs20-debian12:nonroot

# ---------------------------------------------------------------------------
# base
# ---------------------------------------------------------------------------
FROM node:${NODE_VERSION} AS base
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    CI=true \
    NEXT_TELEMETRY_DISABLED=1
RUN corepack enable
WORKDIR /repo

# ---------------------------------------------------------------------------
# build — compile workspace type deps, then the Next standalone bundle
# ---------------------------------------------------------------------------
FROM base AS build
COPY . .
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile
RUN pnpm exec tsc -b
RUN pnpm --filter @montr/web build:next

# ---------------------------------------------------------------------------
# runtime — distroless; standalone server + traced node_modules only
# ---------------------------------------------------------------------------
FROM ${DISTROLESS} AS runtime
LABEL org.opencontainers.image.title="montr-secure-web" \
      org.opencontainers.image.description="Montr Secure operator console (Next.js)" \
      org.opencontainers.image.source="https://github.com/montr/secure" \
      org.opencontainers.image.licenses="Proprietary"
WORKDIR /app
ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    NEXT_TELEMETRY_DISABLED=1
# Monorepo standalone layout: the traced server tree is rooted at the standalone
# dir; the app entrypoint + assets nest under apps/web/.
COPY --from=build --chown=nonroot:nonroot /repo/apps/web/.next/standalone ./
COPY --from=build --chown=nonroot:nonroot /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=nonroot:nonroot /repo/apps/web/public ./apps/web/public
USER nonroot
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
    CMD ["/nodejs/bin/node", "-e", "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/').then(function(r){process.exit(r.status<500?0:1)}).catch(function(){process.exit(1)})"]
# distroless nodejs image ENTRYPOINT is node; run the standalone server.
CMD ["apps/web/server.js"]
