# syntax=docker/dockerfile:1.7
# Montr Secure — BullMQ worker host (runs the orchestrator + layer agents).
# Multi-stage, DISTROLESS, non-root. The worker checks out repos into a
# writable /workspace volume (tmpfs/emptyDir) so the root FS can stay read-only.
#
# Build context is the REPO ROOT (docker-compose.yml sets `context: ../..`).

ARG NODE_VERSION=20-bookworm-slim
ARG DISTROLESS=gcr.io/distroless/nodejs20-debian12:nonroot

# ---------------------------------------------------------------------------
# base
# ---------------------------------------------------------------------------
FROM node:${NODE_VERSION} AS base
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    CI=true
RUN corepack enable
WORKDIR /repo

# ---------------------------------------------------------------------------
# build
# ---------------------------------------------------------------------------
FROM base AS build
COPY . .
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile
RUN pnpm exec tsc -b
RUN pnpm --filter @montr/worker deploy --prod --legacy /app

# ---------------------------------------------------------------------------
# runtime
# ---------------------------------------------------------------------------
# Runtime is a hardened SLIM base (not distroless): the worker runs the Layer-1
# discovery scanners, and Semgrep needs a Python runtime — so it needs a real OS.
# Hardened instead via non-root user, read-only root FS (compose/Helm securityContext),
# and the default-deny-egress NetworkPolicy. Scanner versions are pinned and are
# refreshed offline via the air-gap signed bundle (deploy/airgap).
FROM node:${NODE_VERSION} AS runtime
LABEL org.opencontainers.image.title="montr-secure-worker" \
      org.opencontainers.image.description="Montr Secure worker (BullMQ + pipeline layers + SAST/secrets/SCA scanners)" \
      org.opencontainers.image.source="https://github.com/montr/secure" \
      org.opencontainers.image.licenses="Proprietary"
ARG GITLEAKS_VERSION=8.21.2
ARG OSV_SCANNER_VERSION=1.9.1
# Semgrep (SAST, Python), gitleaks (secrets, static Go), osv-scanner (SCA, static Go),
# git (repo checkout). curl is removed after use to shrink attack surface.
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-pip python3-venv git ca-certificates curl \
 && python3 -m pip install --no-cache-dir --break-system-packages semgrep \
 && curl -fsSL "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz" \
      | tar -xz -C /usr/local/bin gitleaks \
 && curl -fsSL -o /tmp/osv-scanner_linux_amd64 \
      "https://github.com/google/osv-scanner/releases/download/v${OSV_SCANNER_VERSION}/osv-scanner_linux_amd64" \
 && curl -fsSL -o /tmp/osv-scanner_SHA256SUMS \
      "https://github.com/google/osv-scanner/releases/download/v${OSV_SCANNER_VERSION}/osv-scanner_SHA256SUMS" \
 && (cd /tmp && grep "osv-scanner_linux_amd64$" osv-scanner_SHA256SUMS | sha256sum -c -) \
 && mv /tmp/osv-scanner_linux_amd64 /usr/local/bin/osv-scanner \
 && chmod +x /usr/local/bin/osv-scanner \
 && rm -f /tmp/osv-scanner_SHA256SUMS \
 && apt-get purge -y curl && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production \
    MONTR_WORKSPACE_DIR=/workspace \
    REDIS_URL=redis://redis:6379
COPY --from=build --chown=node:node /app /app
USER node
# The worker has no HTTP port; liveness = it can reach Redis (its job broker).
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["node", "-e", "const u=new URL(process.env.REDIS_URL||'redis://redis:6379');const s=require('net').connect({host:u.hostname,port:Number(u.port)||6379});s.setTimeout(3000);s.on('connect',function(){s.end();process.exit(0)});s.on('error',function(){process.exit(1)});s.on('timeout',function(){process.exit(1)})"]
CMD ["dist/main.js"]
