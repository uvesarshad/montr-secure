# Montr Secure — docker-compose environment. Copy to `.env` and fill in.
# SAFETY-FIRST DEFAULTS: auto-fix OFF, DAST OFF, budget hard-halt ON, telemetry OFF.

# --- Postgres ---
POSTGRES_USER=montr
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=montr
DATABASE_URL=postgresql://montr:change-me-in-prod@postgres:5432/montr?schema=public

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- LLM (BYO-key; the ONLY permitted outbound call) ---
MONTR_LLM_PROVIDER=anthropic
# Leave blank and inject via secret in real deployments. Never commit a real key.
MONTR_LLM_API_KEY=
# MONTR_LLM_ENDPOINT=            # optional internal/air-gapped model proxy

# --- Field encryption (AES-256-GCM) for LLM key/tokens at rest ---
MONTR_FIELD_ENCRYPTION_KEY_REF=

# --- Hardened policy toggles (defaults shown) ---
MONTR_AUTOFIX_ENABLED=false
MONTR_DAST_ENABLED=false
MONTR_BUDGET_ENFORCEMENT=hard_halt
MONTR_TELEMETRY_ENABLED=false
