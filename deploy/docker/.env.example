# =============================================================================
# Montr Secure — docker-compose environment. Copy to `.env` and fill in secrets.
#   cp .env.example .env
#
# This file enumerates EVERY key of @montr/config that is wired to an env var in
# the loader (packages/config/src/loader.ts). Values shown are the HARDENED,
# SAFETY-FIRST DEFAULTS (§11): auto-fix OFF, DAST OFF, budget hard-halt ON,
# telemetry OFF, egress default-deny. An unconfigured deployment is the safe one.
#
# Keys with NO env mapping (retention, rbac, nested budget/DAST/auto-fix policy)
# are set via a JSON config file — see the "FULL CONFIG FILE" section at the end
# and `config.example.json`.
#
# `.env` is git-ignored. NEVER commit a real LLM key or DB password.
# =============================================================================

# --- Infrastructure: Postgres 16 -------------------------------------------
POSTGRES_USER=montr
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=montr
# Consumed by Prisma (@montr/state-store). Host `postgres` = the compose service.
DATABASE_URL=postgresql://montr:change-me-in-prod@postgres:5432/montr?schema=public

# --- Infrastructure: Redis 7 (BullMQ broker) -------------------------------
REDIS_URL=redis://redis:6379

# --- Tenant ----------------------------------------------------------------
# Row-scoped per-client isolation identifier (@montr/config clientId).
MONTR_CLIENT_ID=default

# =============================================================================
# LLM ACCESS (BYO-key). ⛔ The client's LLM endpoint is the ONLY permitted
# outbound call (golden rule #1). Source SDKs live only in @montr/llm-gateway.
# =============================================================================
# One of: anthropic | bedrock | vertex | azure
MONTR_LLM_PROVIDER=anthropic
# ⛔ Leave BLANK here and inject via a secret manager in real deployments.
# Never commit a real key. (Mapped to llm.apiKey.)
MONTR_LLM_API_KEY=
# Optional: name of the secret/env holding the key (for external secret stores).
MONTR_LLM_API_KEY_REF=
# Optional: internal / air-gapped model-proxy base URL. When set, this is the
# single egress destination the NetworkPolicy must allow. (See deploy/airgap.)
# MONTR_LLM_ENDPOINT=https://llm-proxy.internal:443
# ⛔ Key-tier guard — warn (default) | block | off. Flags suspected
# data-retaining (non-enterprise) key tiers.
MONTR_LLM_KEY_TIER_GUARD=warn

# --- Model matrix (DECIDE-3; confirmation floor = Sonnet-5-class) ----------
MONTR_MODEL_TRIAGE=claude-haiku-4-5-20251001
MONTR_MODEL_DEFAULT=claude-sonnet-5
MONTR_MODEL_CONFIRMATION=claude-opus-4-8

# =============================================================================
# BUDGET (cost is a first-class output). DECIDE-4 = hard halt.
# =============================================================================
# Optional hard ceilings; leave blank for no ceiling (hard-halt then no-ops).
# MONTR_BUDGET_MAX_USD=25
# MONTR_BUDGET_MAX_TOKENS=5000000
# ⛔ hard_halt (default) stops the pipeline + emits a partial report; never
# silently burns tokens. Only other value: warn.
MONTR_BUDGET_ENFORCEMENT=hard_halt

# =============================================================================
# AUTO-FIX (⛔ OFF by default). Even ON, only `auto-eligible` fixes open PRs,
# never direct commits; auth/session/crypto/access-control stay human-required.
# =============================================================================
MONTR_AUTOFIX_ENABLED=false

# =============================================================================
# DAST / live confirmation (⛔ OFF by default, DECIDE-1). Production is blocked
# by policy; kill switch always on; approver authorization required.
# =============================================================================
MONTR_DAST_ENABLED=false
# Comma-separated staging allowlist. Empty = nothing may be probed.
MONTR_DAST_ALLOWLIST=

# =============================================================================
# TELEMETRY (⛔ OFF by default — no vendor telemetry, §10).
# =============================================================================
MONTR_TELEMETRY_ENABLED=false

# =============================================================================
# SECURITY / crypto & egress.
# =============================================================================
# Reference to the AES-256-GCM field-encryption key (KMS/Vault/secret). Required
# to encrypt the LLM key + VCS tokens at rest. Inject via a secret manager.
MONTR_FIELD_ENCRYPTION_KEY_REF=
# Comma-separated extra egress hosts (beyond the LLM endpoint). Keep EMPTY for a
# pure default-deny posture. (egressPolicy itself is locked to "default-deny".)
MONTR_ALLOWED_EGRESS_HOSTS=

# =============================================================================
# FULL CONFIG FILE (keys without an env mapping).
# =============================================================================
# The following @montr/config keys are only settable via a JSON config file
# (they have no env var), and env vars above override the file where both apply:
#   budget.requireEstimateApproval, budget.warnThresholdPct
#   autoFix.allowedRiskClasses, autoFix.humanRequiredCategoriesAlways
#   dast.scope.{maxRequestsPerScan,maxConcurrentRequests,
#              maxRequestsPerSecond,maxMutatingRequests}, dast.requireApprover
#   retention.{scanDays,appMapDays,auditDays,auditImmutable}
#   rbac.{approverRequiredForGate,approverRequiredForDast,sessionTtlMinutes}
#   telemetry.{endpoint,anonymized}, llm.enforceModelFloor
# Locked (safety) fields, shown for reference only: autoFix.prOnly=true,
# dast.productionBlocked=true, dast.killSwitchEnabled=true,
# security.egressPolicy=default-deny.
#
# To use it: `cp config.example.json config.json`, edit, then uncomment the
# MONTR_CONFIG_FILE env + volume mount in docker-compose.yml.
# MONTR_CONFIG_FILE=/etc/montr/config.json
