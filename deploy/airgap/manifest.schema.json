{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://montr.ai/schemas/airgap-bundle-manifest.json",
  "title": "Montr Secure air-gap bundle manifest",
  "description": "Describes the contents of a signed offline update bundle (Semgrep/gitleaks rulesets + CVE/OSV/GHSA database mirrors). The whole bundle tarball is signed; every artifact additionally carries a SHA-256 that the importer verifies before installing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "version", "createdAt", "artifacts"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "name": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "description": "SemVer of the bundle content set.",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+].+)?$"
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "producer": { "type": "string", "description": "Who built the bundle." },
    "montrMinVersion": {
      "type": "string",
      "description": "Minimum Montr Secure version that can consume this bundle."
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "type", "sha256", "sizeBytes"],
        "properties": {
          "path": {
            "type": "string",
            "description": "Path of the artifact inside the bundle, relative to the bundle root.",
            "pattern": "^(?!/)(?!.*\\.\\.).+$"
          },
          "type": {
            "enum": [
              "semgrep-rules",
              "gitleaks-rules",
              "osv-mirror",
              "ghsa-mirror",
              "cve-db",
              "other"
            ]
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "sizeBytes": { "type": "integer", "minimum": 0 },
          "version": { "type": "string" },
          "installTo": {
            "enum": ["semgrep", "gitleaks", "cve", "custom"],
            "description": "Target install location key resolved by import-bundle.sh."
          }
        }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": { "enum": ["cosign-keyless", "cosign-key"] },
        "signatureFile": { "type": "string" },
        "certificateFile": { "type": "string" }
      }
    }
  }
}
