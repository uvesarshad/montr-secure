{
  "name": "@montr/qa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "montr-qa": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "qa:corpus": "tsc -b && node dist/cli.js",
    "qa:corpus:selfcheck": "tsc -b && node dist/cli.js",
    "qa:variance": "tsc -b && node dist/cli.js --variance",
    "qa:variance:selfcheck": "tsc -b && node dist/cli.js --variance --variance-selfcheck",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "@montr/config": "workspace:*",
    "@montr/confirm": "workspace:*",
    "@montr/contracts": "workspace:*",
    "@montr/fixtures": "workspace:*",
    "fast-glob": "^3.3.3"
  }
}
