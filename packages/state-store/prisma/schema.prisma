// Montr Secure — Prisma schema (build-plan §3.4, PRD §9).
//
// PER-CLIENT ISOLATION (§8.3): row-scoped multitenancy. Every table carries a
//   `clientId` and is indexed by it; the @montr/state-store repositories scope
//   EVERY query by clientId so per-client data is never shared. (Schema-per-
//   client is the stricter alternative for high-isolation deployments — swap the
//   datasource per tenant; the models are unchanged.)
//
// FIELD-LEVEL ENCRYPTION (§11): fields annotated `/// @encrypted` are encrypted
//   at rest with AES-256-GCM using a key from KMS/Vault/k8s secret (the
//   prisma-field-encryption extension convention, wired in @montr/state-store,
//   WS-C). Applies to the client's LLM key + tokens. Secrets are never logged
//   and never egressed except to their own provider (golden rule #1).
//
// DECIDE-2: AppMap is persisted per client with a rebuild-on-stale-commit
//   policy (`AppMap.rebuildPolicy`, `AppMap.stale`).
//
// CONSISTENCY: enum values below mirror the @montr/contracts Zod enums exactly
//   (via @map where a value is not a valid Prisma identifier, e.g. "auto-eligible").
//   Nested value objects (scope, cost, proofArtifact, App Map sub-collections)
//   are stored as validated Json whose shape is the corresponding Zod schema.
//   AuditEvent.action is String because its values are dotted ("scan.created");
//   the Zod AuditAction enum remains the source of truth.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --------------------------------------------------------------------------- //
// Enums (mirror @montr/contracts)
// --------------------------------------------------------------------------- //

enum Provider {
  anthropic
  bedrock
  vertex
  azure
  // A3: six additional BYO-key providers reached through the generic
  // OpenAI-compatible adapter (packages/llm-gateway/src/adapters/openai-compatible.ts).
  openai
  google
  xai
  moonshot
  zhipu
  deepseek
}

enum ScanMode {
  full
  diff
}

enum ScanStatus {
  queued
  running
  paused
  completed
  failed
  cancelled
  partial
}

enum GateState {
  not_started
  estimate_pending
  estimate_approved
  running
  fix_gate_pending
  auto_approved
  approved
  rejected
  blocked
}

enum LayerId {
  layer0
  layer1
  layer2
  layer3
  layer4
  layer5
}

enum Severity {
  info
  low
  medium
  high
  critical
}

enum Exposure {
  public
  authed
}

enum ProofType {
  static
  live
}

enum FindingStatus {
  candidate
  probable
  confirmed
  unconfirmed
}

enum RiskClass {
  auto_eligible  @map("auto-eligible")
  human_required @map("human-required")
}

enum FixStatus {
  proposed
  pr_open  @map("pr-open")
  merged
  rejected
}

enum VcsProvider {
  github
  gitlab
}

enum PullRequestStatus {
  draft
  open
  merged
  closed
}

enum Role {
  operator
  approver
  viewer
}

enum AppMapRebuildPolicy {
  rebuild_on_stale_commit
  always_rebuild
  never_rebuild
}

enum Category {
  sql_injection
  nosql_injection
  command_injection
  xss
  ssrf
  path_traversal
  insecure_deserialization
  hardcoded_secret
  vulnerable_dependency
  permissive_cors
  missing_security_headers
  insecure_cookie
  weak_crypto
  broken_access_control
  broken_authentication
  open_redirect
  xxe
  csrf
  sensitive_data_exposure
  insufficient_logging
  idor
  mass_assignment
  rate_limit_missing
  prompt_injection
  insecure_configuration
  other
}

/// Cross-scan learned-fact kinds actually PERSISTED on `LearnedFact` (E8, §15).
/// `confirmed_false_positive` is deliberately NOT a member here: that class of
/// fact already lives in the audit log's `finding.marked_false_positive` events
/// (A10's FalsePositiveMarkRepository) and is merged in at READ time instead of
/// duplicated into this table — see LearnedFactRepositoryImpl's doc comment
/// (packages/state-store/src/learned-facts.ts) and apps/worker/src/runners.ts's
/// loadLearnedFactsContext.
enum LearnedFactType {
  custom_sanitizer
  framework_idiom
  operator_decision
}

// --------------------------------------------------------------------------- //
// Tenancy & identity
// --------------------------------------------------------------------------- //

model Client {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users         User[]
  scans         Scan[]
  appMaps       AppMap[]
  auditEvents   AuditEvent[]
  dastTargets   DastTarget[]
  llmCredential LlmCredential?

  // Phase-4 (Wave 5) — scale & intelligence (appended; per-client isolated).
  customRules      CustomRule[]
  redTeamScenarios RedTeamScenario[]
  scanSchedules    ScanSchedule[]
  postureSnapshots PostureSnapshot[]

  // §15 cross-scan memory (E8, appended; per-client isolated).
  learnedFacts LearnedFact[]

  // Blue-team / purple-team entities (B1, appended; per-client isolated).
  detectionRules    DetectionRule[]
  attackPaths       AttackPath[]
  detectionCoverage DetectionCoverage[]
}

model User {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id])
  email        String
  passwordHash String // argon2 hash (one-way; not reversible)
  role         Role     @default(viewer)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  operatedScans           Scan[]            @relation("ScanOperator")
  approvedScans           Scan[]            @relation("ScanApprover")
  approvedDastTargets     DastTarget[]      @relation("DastApprover")
  liveAuthorizedScenarios RedTeamScenario[] @relation("ScenarioLiveAuthorizer")

  @@unique([clientId, email])
  @@index([clientId])
}

/// BYO-key LLM credential. Secrets are field-encrypted at rest (§11).
model LlmCredential {
  id           String   @id @default(cuid())
  clientId     String   @unique
  client       Client   @relation(fields: [clientId], references: [id])
  provider     Provider
  endpoint     String?
  /// @encrypted — AES-256-GCM (KMS/Vault key). Never egressed except to its provider.
  apiKey       String
  /// @encrypted
  refreshToken String?
  keyTier      String   @default("unknown")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// --------------------------------------------------------------------------- //
// App Map (PRD §9, DECIDE-2)
// --------------------------------------------------------------------------- //

model AppMap {
  id                String              @id @default(cuid())
  clientId          String
  client            Client              @relation(fields: [clientId], references: [id])
  repo              String
  branch            String
  commitSha         String
  languages         Json // Language[]
  frameworks        Json // Framework[]
  entrypoints       Json // Entrypoint[]
  dataStores        Json // DataStore[]
  ormModels         Json // OrmModel[] (Prisma DMMF-derived)
  thirdPartyCalls   Json // ThirdPartyCall[]
  envSecretSurfaces Json // EnvSecretSurface[]
  taintFlows        Json                @default("[]") // TaintFlowEdge[] (resolved interprocedural flows)
  /// ThreatModel (E6/B1) — the Layer-0 threat-model sub-step's output for this
  /// AppMap. Optional/nullable: older rows and any AppMap built before E6
  /// shipped have none. Promotes `AppMapSchema.threatModel` (E6, in-memory-only
  /// on the Zod type) to a genuinely persisted field — see docs/api/database.md
  /// "Threat Model Persistence (B1)" for why this lives directly on `AppMap`
  /// rather than a separate table (1:1 with the AppMap it was derived from, no
  /// independent lifecycle or query pattern of its own).
  threatModel       Json?
  stale             Boolean             @default(false)
  rebuildPolicy     AppMapRebuildPolicy @default(rebuild_on_stale_commit)
  createdAt         DateTime            @default(now())

  routes       Route[]
  taintSources TaintSource[]
  taintSinks   TaintSink[]
  scans        Scan[]
  codeChunks   CodeChunk[]

  @@unique([clientId, repo, commitSha])
  @@index([clientId])
}

model Route {
  id         String  @id @default(cuid())
  appMapId   String
  appMap     AppMap  @relation(fields: [appMapId], references: [id], onDelete: Cascade)
  path       String
  method     String // HttpMethod
  authState  String // AuthState
  isApiRoute Boolean @default(false)
  authGate   String?
  handler    Json? // SourceLocation

  @@index([appMapId])
}

model TaintSource {
  id          String  @id @default(cuid())
  appMapId    String
  appMap      AppMap  @relation(fields: [appMapId], references: [id], onDelete: Cascade)
  kind        String // TaintSourceKind
  location    Json // SourceLocation
  description String?
  routeId     String?

  @@index([appMapId])
}

model TaintSink {
  id          String  @id @default(cuid())
  appMapId    String
  appMap      AppMap  @relation(fields: [appMapId], references: [id], onDelete: Cascade)
  kind        String // TaintSinkKind
  location    Json // SourceLocation
  description String?

  @@index([appMapId])
}

/// Semantic codebase index (E5) — AST-chunked source + its embedding vector,
/// built once per commit alongside its parent AppMap and reused by diff scans.
/// See packages/semantic-index for the chunker/embedder/query-path that
/// populates and reads this table.
///
/// ⛔ REQUIRES the Postgres `vector` extension (pgvector) — NOT enabled by the
///   bundled dev images in deploy/docker or deploy/helm today (see migration
///   5_semantic_code_index and docs/api/database.md). STRICTLY ADDITIVE.
///
/// `embedding` is declared `Unsupported("vector(N)")`: Prisma Client generates
/// no typed accessor for it (pgvector has no native Prisma column type), so
/// every read/write of this column goes through $queryRaw/$executeRaw in
/// packages/semantic-index's repository — the other columns are ordinary and
/// go through the generated client as usual. The width (1536) is fixed to the
/// one embedding model @montr/llm-gateway implements today (Azure OpenAI
/// text-embedding-3-small); pgvector's ANN index requires a compile-time-fixed
/// dimension, so supporting a different-width model needs either a migration
/// widening this column or a dedicated table — see the migration file.
model CodeChunk {
  id             String                       @id @default(cuid())
  clientId       String
  appMapId       String
  appMap         AppMap                       @relation(fields: [appMapId], references: [id], onDelete: Cascade)
  repo           String
  commitSha      String
  file           String
  startLine      Int
  endLine        Int
  language       String // Language (Zod enum is source of truth, @montr/contracts)
  kind           String // ChunkKind ("function" | "method" | "class" — @montr/semantic-index)
  symbolName     String?
  contentHash    String // sha256(content) — lets a rebuild skip re-embedding an unchanged chunk
  content        String // chunk source text (not @encrypted — mirrors CandidateFinding.evidenceSnippet's precedent for source-code text)
  embeddingModel String // provider-qualified embedding model id that produced `embedding`
  embedding      Unsupported("vector(1536)")?
  createdAt      DateTime                     @default(now())

  @@index([clientId])
  @@index([appMapId])
  @@index([clientId, repo, commitSha])
}

// --------------------------------------------------------------------------- //
// Scan lifecycle (PRD §9)
// --------------------------------------------------------------------------- //

model Scan {
  id           String     @id @default(cuid())
  clientId     String
  client       Client     @relation(fields: [clientId], references: [id])
  appMapId     String?
  appMap       AppMap?    @relation(fields: [appMapId], references: [id])
  repo         String
  branch       String
  commitSha    String?
  mode         ScanMode
  status       ScanStatus @default(queued)
  gateState    GateState  @default(not_started)
  operatorId   String
  operator     User       @relation("ScanOperator", fields: [operatorId], references: [id])
  approverId   String?
  approver     User?      @relation("ScanApprover", fields: [approverId], references: [id])
  scope        Json // ScanScope
  budgetPolicy Json? // BudgetPolicy
  costEstimate Json? // CostEstimate
  costActual   Json? // CostActual
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime   @default(now())

  candidates   CandidateFinding[]
  probable     ProbableFinding[]
  confirmed    ConfirmedFinding[]
  fixes        Fix[]
  pullRequests PullRequest[]
  states       ScanState[]
  report       Report?

  // Blue-team / purple-team entities (B1).
  detectionRules    DetectionRule[]
  attackPaths       AttackPath[]
  detectionCoverage DetectionCoverage[]

  @@index([clientId])
  @@index([clientId, status])
}

/// Resumable pipeline state (§8.1) + resume-token checkpoint.
model ScanState {
  id              String     @id @default(cuid())
  clientId        String
  scanId          String
  scan            Scan       @relation(fields: [scanId], references: [id], onDelete: Cascade)
  layer           LayerId
  status          ScanStatus
  completedLayers Json // LayerId[]
  checkpoint      Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([clientId, scanId])
}

// --------------------------------------------------------------------------- //
// Findings (PRD §9). Unconfirmed = a demoted ProbableFinding (status +
// unconfirmedReason) — kept, never deleted.
// --------------------------------------------------------------------------- //

model CandidateFinding {
  id              String        @id @default(cuid())
  clientId        String
  scanId          String
  scan            Scan          @relation(fields: [scanId], references: [id], onDelete: Cascade)
  source          String // ToolSource
  ruleId          String
  category        Category
  cwe             Json // CweId[]
  file            String
  line            Int
  rawSeverity     Severity
  evidenceSnippet String
  status          FindingStatus @default(candidate)
  metadata        Json?
  createdAt       DateTime      @default(now())

  @@index([clientId, scanId])
}

model ProbableFinding {
  id                     String        @id @default(cuid())
  clientId               String
  scanId                 String
  scan                   Scan          @relation(fields: [scanId], references: [id], onDelete: Cascade)
  rootCauseId            String
  category               Category
  mergedCandidateIds     Json // Id[]
  reachabilityHypothesis String
  exploitHypothesis      String
  exposure               Exposure
  authGate               String?
  routeId                String?
  file                   String
  line                   Int
  reachabilityScore      Float
  exposureScore          Float
  impactScore            Float
  rank                   Int
  status                 FindingStatus @default(probable)
  unconfirmedReason      String? // set when demoted to the unconfirmed appendix
  createdAt              DateTime      @default(now())

  @@index([clientId, scanId])
}

model ConfirmedFinding {
  id            String        @id @default(cuid())
  clientId      String
  scanId        String
  scan          Scan          @relation(fields: [scanId], references: [id], onDelete: Cascade)
  probableId    String?
  title         String
  category      Category
  cwe           Json // CweId[]
  owasp         String? // OwaspId
  severity      Severity
  exposure      Exposure
  file          String
  line          Int
  impact        String
  proofType     ProofType
  proofArtifact Json // ProofArtifact (static | live)
  status        FindingStatus @default(confirmed)
  createdAt     DateTime      @default(now())

  fixes Fix[]

  @@index([clientId, scanId])
}

// --------------------------------------------------------------------------- //
// Fixes & PRs (PRD §9)
// --------------------------------------------------------------------------- //

model Fix {
  id                 String           @id @default(cuid())
  clientId           String
  scanId             String
  scan               Scan             @relation(fields: [scanId], references: [id], onDelete: Cascade)
  confirmedFindingId String
  confirmedFinding   ConfirmedFinding @relation(fields: [confirmedFindingId], references: [id], onDelete: Cascade)
  patch              String
  rationale          String
  proofOfFixTest     Json // ProofOfFixTest
  riskClass          RiskClass
  riskClassRationale String
  status             FixStatus        @default(proposed)
  pullRequestId      String?
  pullRequest        PullRequest?     @relation(fields: [pullRequestId], references: [id])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([clientId, scanId])
}

model PullRequest {
  id          String            @id @default(cuid())
  clientId    String
  scanId      String
  scan        Scan              @relation(fields: [scanId], references: [id], onDelete: Cascade)
  provider    VcsProvider
  url         String?
  number      Int?
  branch      String
  baseBranch  String            @default("main")
  title       String
  bodySummary String
  fixIds      Json // Id[]
  status      PullRequestStatus @default(open)
  createdAt   DateTime          @default(now())

  fixes Fix[]

  @@index([clientId, scanId])
}

// --------------------------------------------------------------------------- //
// Report, prompts, DAST, audit
// --------------------------------------------------------------------------- //

model Report {
  id          String   @id @default(cuid())
  clientId    String
  scanId      String   @unique
  scan        Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  generatedAt DateTime @default(now())
  document    Json // full Report (§12)

  @@index([clientId])
}

/// Prompt registry/versioning (§15) — feeds regression tuning. Global (clientId null) or per-client.
/// `version` is a monotonic counter PER `name` across ALL clients (see the unique
/// index below). Exactly one row per (name, clientId) scope should carry
/// `isActive: true` at a time — enforced in the repository, not the DB, since
/// Prisma has no partial-unique-index support here.
model PromptVersion {
  id        String   @id @default(cuid())
  clientId  String?
  name      String
  version   Int
  layer     LayerId?
  template  String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([name, version])
  @@index([clientId])
  @@index([name, clientId, isActive])
}

/// Cross-scan memory (E8, §15) — durable, per-repo learned facts (custom
/// sanitizer names, framework idioms, operator decisions) injected as OPTIONAL,
/// ADDITIVE context into a LATER scan's Layer 1/2/3 LLM prompts for the same
/// `(clientId, repo)`. This generalizes A10's §15 false-positive tuning loop
/// (`FalsePositiveMarkRepository`, sourced from the audit log) to a broader
/// class of learned facts; it does NOT duplicate the FP-mark data — see the
/// `LearnedFactType` enum's doc comment and `LearnedFactRepositoryImpl` in
/// packages/state-store/src/learned-facts.ts. Never overrides deterministic
/// logic: the read path only appends context text to an existing prompt.
model LearnedFact {
  id         String          @id @default(cuid())
  clientId   String
  client     Client          @relation(fields: [clientId], references: [id])
  repo       String
  type       LearnedFactType
  content    Json // free-form structured payload; shape depends on `type` (LearnedFactContent, state-store/src/types.ts)
  provenance Json // LearnedFactProvenance — { source: "operator" | "scan_derived", scanId?, operatorId?, at }
  createdAt  DateTime        @default(now())

  @@index([clientId])
  @@index([clientId, repo])
  @@index([clientId, repo, type])
}

/// DAST allowlist + scope contract (§11). Nothing may be probed unless enabled + approved.
model DastTarget {
  id            String    @id @default(cuid())
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id])
  url           String
  enabled       Boolean   @default(false)
  scopeContract Json // DastScopeContract
  approvedById  String?
  approvedBy    User?     @relation("DastApprover", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@unique([clientId, url])
  @@index([clientId])
}

/// Append-only, hash-chained audit log (§8.5, §14). Never updated or deleted.
model AuditEvent {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id])
  sequence   Int // monotonic per client
  scanId     String?
  actorType  String // ActorType
  actorId    String
  actorRole  Role?
  action     String // AuditAction (dotted; Zod enum is source of truth)
  targetType String?
  targetId   String?
  summary    String
  metadata   Json // scrubbed of code/secret bodies before write
  prevHash   String
  hash       String
  at         DateTime @default(now())

  @@unique([clientId, sequence])
  @@index([clientId, scanId])
}

// --------------------------------------------------------------------------- //
// Phase-4 (Wave 5) — Scale & Intelligence (PRD §16). STRICTLY ADDITIVE.
//   Every table is per-client isolated (clientId + index) and every mutation is
//   audit-logged by the API layer (§8.5). Enum/String value choices mirror the
//   @montr/contracts Zod schemas exactly (category stored as String because its
//   vocab is owned by the Zod RedTeamCategory enum, mirroring AuditEvent.action).
// --------------------------------------------------------------------------- //

enum RuleEngine {
  semgrep
  secret
}

/// Client-authored detection rule (custom Semgrep rule or secret detector).
/// `enabled` defaults false — a rule must be VALIDATED before it can be turned on.
/// `body` is a detection rule, never a credential (not encrypted; needs validation).
model CustomRule {
  id        String     @id @default(cuid())
  clientId  String
  client    Client     @relation(fields: [clientId], references: [id])
  name      String
  language  String // Language (Zod enum is source of truth)
  engine    RuleEngine
  body      String // Semgrep YAML / secret-detector definition
  version   Int        @default(1)
  enabled   Boolean    @default(false)
  createdBy String
  createdAt DateTime   @default(now())

  @@unique([clientId, name, version])
  @@index([clientId])
}

/// Reusable, versioned red-team / DAST scenario (§16). `enabled` defaults false.
/// ⛔ `targetAllowlistRef` binds a scenario to an allowlisted DAST target/scope;
///    running one is approver-authorized + routed via the @montr/security egress
///    guard + kill switch (§11). `steps` is field-encrypted at rest (attack
///    playbooks are sensitive) — AES-256-GCM, key from KMS/Vault/k8s secret.
/// A1 (2026-09-12 red/blue agentic-posture audit) — `liveAuthorized*` fields
/// capture EXPLICIT WRITTEN authorization for real worker-side live execution,
/// beyond RBAC + the allowlist: `liveAuthorizationReference` is a required
/// free-text record (ticket/agreement reference) an approver supplies via
/// `POST /scenarios/:id/authorize`, and `liveAuthorizedForVersion` binds the
/// grant to one exact `version` — any edit bumps `version` and the app layer
/// clears these fields, so a stale authorization can never cover a changed
/// scenario. See packages/contracts/src/phase4.ts's `hasLiveRunAuthorization`.
model RedTeamScenario {
  id                 String   @id @default(cuid())
  clientId           String
  client             Client   @relation(fields: [clientId], references: [id])
  name               String
  category           String // RedTeamCategory (Zod enum is source of truth)
  /// @encrypted — JSON-serialized RedTeamStep[] stored as an AES-256-GCM envelope.
  steps              String
  targetAllowlistRef String
  version            Int      @default(1)
  enabled            Boolean  @default(false)
  createdBy          String
  createdAt          DateTime @default(now())

  liveAuthorizedById         String?
  liveAuthorizedBy           User?     @relation("ScenarioLiveAuthorizer", fields: [liveAuthorizedById], references: [id])
  liveAuthorizationReference String?
  liveAuthorizedAt           DateTime?
  liveAuthorizedForVersion   Int?

  @@unique([clientId, name, version])
  @@index([clientId])
}

/// Cron-scheduled scan (§16). `enabled` defaults false. ⛔ `budgetCeiling` (USD)
/// is a hard per-run ceiling; scheduled runs still honor the human gate.
model ScanSchedule {
  id            String    @id @default(cuid())
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id])
  repo          String
  mode          ScanMode  @default(full)
  cron          String
  budgetCeiling Float
  enabled       Boolean   @default(false)
  nextRunAt     DateTime?
  createdBy     String
  createdAt     DateTime  @default(now())

  @@index([clientId])
  @@index([clientId, repo])
}

/// Posture-over-time snapshot for a repo (§16). Derived from a completed scan's
/// CONFIRMED findings only (never raw candidates — golden rule "never headline
/// raw counts"). Persisted per client for fast trend/regression queries.
model PostureSnapshot {
  id                  String   @id @default(cuid())
  clientId            String
  client              Client   @relation(fields: [clientId], references: [id])
  scanId              String
  repo                String
  at                  DateTime @default(now())
  confirmedBySeverity Json // SeverityCounts (Partial<Record<Severity, number>>)
  total               Int      @default(0)
  delta               Json? // PostureDelta (vs previous snapshot for this repo)
  createdAt           DateTime @default(now())

  @@index([clientId])
  @@index([clientId, repo])
  @@index([clientId, scanId])
}

// --------------------------------------------------------------------------- //
// Blue-team / purple-team entities (B1). STRICTLY ADDITIVE. Every table is
// per-client isolated (clientId + index, plus a real Client FK — mirrors
// LearnedFact/CustomRule's precedent). `findingId`/`detectionRuleId` fields are
// deliberately PLAIN string references, not Prisma relations — mirrors
// `ConfirmedFinding.probableId`'s existing loose-reference precedent across
// finding tiers, and sidesteps enforcing an FK into a Json-embedded id
// (`AttackPath.steps`) where a real relation isn't possible anyway.
//
// ENCRYPTION: none of `DetectionRule.content`, `AttackPath.narrative`, or
// `DetectionCoverage.reasoning` are field-encrypted, despite describing
// exploit-adjacent detail. Two precedents justify this: (1) `CustomRule.body`
// — itself a detection-rule body — is explicitly documented as not encrypted;
// (2) `ConfirmedFinding.proofArtifact`, the MOST sensitive exploit-detail field
// in this schema (live HTTP transcripts against a real target), is already
// stored as plain Json. Encrypting a detection rule DERIVED FROM an unencrypted
// proof artifact would add no real confidentiality (DB access already exposes
// the proof it was built from) while breaking this table's query/index
// patterns (B7 report assembly, B10 compliance export). See
// docs/api/database.md for the full writeup.
// --------------------------------------------------------------------------- //

/// Tri-state detection verdict (mirrors `DetectionStatusSchema`, @montr/contracts).
/// A real Prisma enum, not a nullable Boolean — "unknown" is a genuine third
/// value (not enough telemetry-surface info to say), not the absence of a row.
enum DetectionStatus {
  detected
  not_detected
  unknown
}

/// Generated detection rule for a confirmed finding (B1 data model; B3
/// authors the actual rule content — Sigma authoring, ATT&CK mapping tables).
/// `format` is a String, not a Prisma enum — the Zod `DetectionRuleFormatSchema`
/// is source of truth and B3 is expected to grow this set (e.g. additional SIEM
/// query dialects) without a schema migration, mirroring
/// `RedTeamScenario.category`/`CustomRule.language`'s precedent.
model DetectionRule {
  id              String    @id @default(cuid())
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id])
  scanId          String
  scan            Scan      @relation(fields: [scanId], references: [id], onDelete: Cascade)
  findingId       String // ConfirmedFinding.id this rule was generated to detect
  format          String // DetectionRuleFormat (Zod enum is source of truth): sigma | otel | siem_query | ...
  content         String // rule text: Sigma YAML / OTel query / SIEM query — see encryption note above
  mitreTechniques Json      @default("[]") // string[] of ATT&CK technique ids (B2 populates the mapping)
  provenance      ProofType // static (data-flow path) | live (DAST transcript) — mirrors ConfirmedFinding.proofType
  logSignature    Json? // B4: DetectionLogSignature ({fields, pattern, falseAlarmSources}) | absent for pre-B4 rows
  createdAt       DateTime  @default(now())

  @@index([clientId])
  @@index([clientId, scanId])
  @@index([clientId, findingId])
}

/// Chained kill-chain across >= 2 confirmed findings (B1 data model; a later
/// wave builds the graph algorithm that populates this). `steps` is Json
/// (an ordered `AttackPathStep[]`) rather than a join table — a small,
/// read-mostly, always-whole-object structure queried by id, never by hop —
/// mirrors `taintFlows`/`ScanState.completedLayers`'s existing precedent for
/// ordered-array-as-Json.
model AttackPath {
  id               String   @id @default(cuid())
  clientId         String
  client           Client   @relation(fields: [clientId], references: [id])
  scanId           String
  scan             Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  steps            Json // AttackPathStep[] (@montr/contracts) — ordered finding-id chain, >= 2 hops
  feasibilityScore Float // 0..1, end-to-end path feasibility
  severity         Severity // end-to-end path severity
  narrative        String // human-readable kill-chain summary
  createdAt        DateTime @default(now())

  @@index([clientId])
  @@index([clientId, scanId])
}

/// Whether a target's existing telemetry would catch a confirmed finding if
/// exploited (B1 data model; B5's purple-team loop populates `verification`
/// by actually running a scenario and checking whether the expected
/// detection fired).
model DetectionCoverage {
  id              String          @id @default(cuid())
  clientId        String
  client          Client          @relation(fields: [clientId], references: [id])
  scanId          String
  scan            Scan            @relation(fields: [scanId], references: [id], onDelete: Cascade)
  findingId       String // ConfirmedFinding.id this coverage verdict is about
  detected        DetectionStatus
  reasoning       String // reasoning/evidence behind the verdict
  detectionRuleId String? // DetectionRule.id covering this finding, if any (plain reference, see header note)
  verification    Json? // DetectionVerificationResult | null (@montr/contracts) — populated by B5
  createdAt       DateTime        @default(now())

  @@index([clientId])
  @@index([clientId, scanId])
  @@index([clientId, findingId])
}
