{
  "name": "@montr/state-store",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "prisma generate --schema=prisma/schema.prisma",
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "seed:redteam": "node scripts/seed-redteam-scenarios.mjs",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "@montr/contracts": "workspace:*",
    "@montr/security": "workspace:*",
    "@montr/telemetry": "workspace:*",
    "@prisma/client": "^5.20.0"
  },
  "devDependencies": {
    "prisma": "^5.20.0"
  }
}
