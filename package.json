{
  "name": "montr-secure",
  "version": "0.0.0",
  "private": true,
  "description": "Montr Secure — AI security orchestration platform (on-prem, BYO-key, report-first with gated auto-fix).",
  "type": "module",
  "engines": {
    "node": ">=20 <25",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "build:tsc": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "turbo run lint",
    "lint:root": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:turbo": "turbo run test",
    "e2e": "node scripts/e2e-scan.mjs",
    "corpus:scan": "node scripts/corpus-scan.mjs",
    "benchmark:owasp": "node scripts/benchmark-owasp.mjs",
    "benchmark:owasp:semgrep": "node scripts/benchmark-semgrep.mjs",
    "benchmark:owasp:codeql": "node scripts/benchmark-codeql.mjs",
    "selfscan": "node scripts/selfscan.mjs",
    "smoke": "node scripts/integration-smoke.mjs",
    "check:unwired-seams": "node scripts/check-unwired-seams.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf **/dist **/.tsbuildinfo node_modules/.cache",
    "prisma:validate": "pnpm --filter @montr/state-store exec prisma validate",
    "prisma:format": "pnpm --filter @montr/state-store exec prisma format",
    "prisma:generate": "pnpm --filter @montr/state-store generate",
    "prepare": "husky || true",
    "postinstall": "pnpm run prisma:generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.9.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
